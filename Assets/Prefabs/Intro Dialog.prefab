--- !u!114 &8999573352500100601
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8257159723527369020}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 230f57ebdcbb11b448b9463cf5dcc4eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  White: {r: 1, g: 1, b: 1, a: 1}
  Black: {r: 0.08235294, g: 0.08235294, b: 0.08235294, a: 1}
  _colorSwitchDuration: 1
  _DialogText: {fileID: 3991492408762602857}
  _DialogImage: {fileID: 6024231814048853981}
  _DialogList:
  - _DialogText: You come home after a long day working as a demonologist in several
      houses and you deside to watch some TV
    _screenTime: 6
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 0}
    _opacityLevel: 0
  - _DialogText: after a few hours you get tired and head to bed
    _screenTime: 4
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 0}
    _opacityLevel: 0
  - _DialogText: You put your night wear on and lay down in bed.
    _screenTime: 4
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 0}
    _opacityLevel: 0
  - _DialogText: Your eyes close and slowly drift off to dreamland.......
    _screenTime: 4
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 0}
    _opacityLevel: 0
  - _DialogText: While sleeping you have a horrible dream
    _screenTime: 4
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 0}
    _opacityLevel: 0
  - _DialogText: The house of a once famous doctor who has passed away many years,
      holds dark secrets....
    _screenTime: 5
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 0}
    _opacityLevel: 0
  - _DialogText: 'There are horrors unseen, teenagers missing..

      Rituals &
      Dark curses.. Doomed to roam the house'
    _screenTime: 6
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 0}
    _opacityLevel: 0
  - _DialogText: 'A distant voice whispers..

      Death... only death... great
      danger...... save the....'
    _screenTime: 6
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 0}
    _opacityLevel: 0
  - _DialogText: The voice dissapears and you wake up petrified
    _screenTime: 4
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 0}
    _opacityLevel: 0
  - _DialogText: '"I have to find out what is wrong with that house!"'
    _screenTime: 4
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 0}
    _opacityLevel: 0
  - _DialogText: You take the car keys and leave to get to the house on the hill.
    _screenTime: 4
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 21300000, guid: d5ae1d4fc64f14b43a5626574ecc4d6f, type: 3}
    _opacityLevel: 0.01
  - _DialogText: Upon arriving you feel a strong ambience of dismay, grief and regret
    _screenTime: 4
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 21300000, guid: d5ae1d4fc64f14b43a5626574ecc4d6f, type: 3}
    _opacityLevel: 0.02
  - _DialogText: Upon entering the porch the door slowly opens, the house invites
      another soul into damnation
    _screenTime: 5
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 21300000, guid: d5ae1d4fc64f14b43a5626574ecc4d6f, type: 3}
    _opacityLevel: 0.03
  - _DialogText: When you have entered the house the door closes with a slam! and
      it gets locked, leaving you stuck inside
    _screenTime: 8
    _Mp4_Effect_Png_ZipMax_txt_baud9600: {fileID: 4390013906511776691}
    _dialogSprite: {fileID: 21300000, guid: d5ae1d4fc64f14b43a5626574ecc4d6f, type: 3}
    _opacityLevel: 0.04
